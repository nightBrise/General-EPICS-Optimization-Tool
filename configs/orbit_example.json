// ==================================================
// 通用 EPICS 优化器 — 配置文件示例（轨道优化）
// ==================================================
// 注释语法：
//   1. 整行注释：以 // 或 # 开头（前面可有空格）
//   2. 行尾注释：JSON 内容后留至少一个空格，再接 // 或 #
//   3. 文件中可混用两种注释风格
//
// 预处理器会先剥离所有注释，再将剩余文本传给标准 JSON 解析器，
// 因此该配置是合法的 JSON + 注释，不需要任何第三方库。

{
    // 任务名称（用于 HDF5 结果文件名和日志显示）
    "name": "轨道优化示例",

    // ============================================
    // variables: 变量 PV（优化器会调节这些值）
    // ============================================
    "variables": [

        // 最低配置：只需要 pv（EPICS 地址）和 range（搜索范围）
        {"pv": "LA-PS:CH00:SETI", "range": [-0.5, 0.5]},

        // 可选字段 base_step：告诉优化器该设备的历史步长（默认 0.01）
        {"pv": "LA-PS:CV00:SETI", "range": [-0.5, 0.5], "base_step": 0.1},

        {"pv": "LA-PS:CH01:SETI", "range": [-0.5, 0.5]},
        {"pv": "LA-PS:CV01:SETI", "range": [-0.5, 0.5]}   # 行尾注释也可以用 #
    ],

    // ============================================
    // objectives: 目标 PV（优化器读取这些值来算分）
    // ============================================
    "objectives": {

        // groups: 目标分组。一组 = 同类物理量（量纲一致）
        //         不同组之间用 group.weight 控制重要性
        "groups": [
            {
                // 组名：仅用于日志输出
                "name": "orbit",
                // 组权重：1.0 为满分，0.5 代表重要性减半
                "weight": 1.0,

                // pvs: 组内目标 PV 列表
                "pvs": [
                    // 完整格式 vvv
                    {
                        "pv": "LA-BI:SBPM1:POS_X",    // EPICS PV 地址
                        "target": 0.0,                // 目标值（默认 0.0）
                        "weight": 1.0,                // 组内权重（默认 1.0）
                        "range": [-0.5, 0.5]          // 可接受区间（可选）
                                                      //   读数在区间内 → 该 PV 不产生惩罚
                                                      //   读数在区间外 → 按 target 偏差惩罚
                                                      //   不设 range → 始终惩罚
                    },
                    // 简化格式：只写 pv 的话 target/weight 全部默认
                    {"pv": "LA-BI:SBPM1:POS_Y", "target": 0.0},  # 简化写法

                    {"pv": "LA-BI:SBPM2:POS_X", "target": 0.0},
                    {"pv": "LA-BI:SBPM2:POS_Y", "target": 0.0}
                ],

                // scoring: 组内评分方式
                //   method: l2 | l1 | max | weighted_sum
                //   params: 额外参数（可选，当前内置策略无额外参数）
                "scoring": {"method": "l2"}
            }
        ],

        // overall_scoring: 多组聚合方式（目前仅 weighted_sum）
        //   总体评分 = (Σ group.weight × 组评分) / Σ group.weight
        "overall_scoring": "weighted_sum"
    },

    // ============================================
    // optimization: 优化器参数
    // ============================================
    "optimization": {
        // Nevergrad 算法名。可用: Compass, NGOpt, CMA, PSO, TwoPointsDE 等
        // 拼写不正确时自动退化为 NGOpt
        "algorithm": "differential_evolution",
        // 最大迭代次数（实数：实际迭代 = budget × len(variables)）
        "budget": 10,

        // 早停机制：连续 N 轮无改进就提前结束，节约时间
        "early_stopping": {
            "enabled": true,              # 是否启用
            "patience": 5,                # 连续无改进次数上限
            "min_relative_improvement": 0.005  # 最小改进阈值（0.5%）
        }
    },

    // ============================================
    // hardware: 硬件控制参数
    // ============================================
    "hardware": {
        "tolerance": 0.1,            // 设定值容差（写回验证用：|读回 − 写入| ≤ tolerance）
        "max_wait": 5,               // 等待设备稳定最大秒数
        "poll_interval": 0.2,        // 轮询间隔秒数（等稳定时读取频率）
        "min_adjust_interval": 0     // 两次调整最小间隔秒数（保护硬件，0=不限制）
    },

    // ============================================
    // simulation: 模拟器配置（仅 --simulator 模式生效）
    // ============================================
    "simulation": {
        "function": "griewank",
        "mode": "scalar",
        "initial_values": {
            "LA-PS:CH00:SETI": 2.5,
            "LA-PS:CV00:SETI": -3.1,
            "LA-PS:CH01:SETI": 4.2,
            "LA-PS:CV01:SETI": -1.8
        }
    }
}
