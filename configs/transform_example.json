// ====================================================================
//  通用 EPICS 优化器 — 完整配置文件示例
// ====================================================================
//
// 本文件涵盖了所有可配置字段的完整说明，可作为模板使用。
//
// ===== 注释语法 =====
//   1. 整行注释：行首以 // 或 # 开头（前面可有空白）
//   2. 行尾注释：在 JSON 内容后留至少一个空格，再接 // 或 #
//   3. 两种风格可混用（本文件用 // 做段落说明，用 # 做行内附加说明）
//   4. 预处理器先剥离注释 → 再交给标准 JSON 解析器 → 无需第三方库
//
// ===== 快速上手 =====
//   1. 复制本文件 → 删掉注释 → 填入你真实的 PV 地址
//   2. 运行: python run_optimization.py --config my_config.json --simulator
//   3. 调试通过后去掉 --simulator 切换到真实 EPICS

{
    // ====================================================================
    //  name — 任务名称
    //  用于: 日志输出、HDF5 结果文件名
    //  必填: 否（缺省 "optimization"）
    // ====================================================================
    "name": "联合优化示例",


    // ====================================================================
    //  variables — 变量 PV（优化器会调整这些旋钮的值）
    //  必填: 是（至少 1 个）
    //
    //  每个条目包含:
    //    pv        — EPICS PV 地址（字符串，必填）
    //    range     — [最小值, 最大值] 搜索边界（数组，必填）
    //    base_step — 参考步长（数字，可选，缺省 0.01）
    //                仅用于步长管理，不影响搜索
    // ====================================================================
    "variables": [

        // --- 校正子（水平和垂直各一对） ---
        {
            "pv": "LA-PS:CH00:SETI",           # EPICS PV 地址
            "range": [-0.5, 0.5],              # 搜索范围: -0.5 到 +0.5
            "base_step": 0.01                  # 参考步长（可选）
        },
        {
            "pv": "LA-PS:CV00:SETI",
            "range": [-0.5, 0.5]
            // base_step 省略 → 自动使用默认 0.01
        },

        // --- 速调管相位（更大的搜索范围） ---
        {
            "pv": "LA-RF:KLY1:SET_PHASE",
            "range": [-2.0, 2.0]              # 相位调节范围通常更宽
        }
    ],


    // ====================================================================
    //  objectives — 目标 PV（优化器读取这些值，与 target 比较后算分）
    //  必填: 是
    //
    //  groups:        目标分组数组。一组 = 一个独立评分单元（量纲一致）
    //  overall_scoring: 组间聚合方式。当前支持 "weighted_sum"
    //                    总评分 = (Σ group.weight × 组评分) / Σ group.weight
    // ====================================================================
    "objectives": {

        // ---------------------------------------------------------------
        //  groups — PV 分组
        //  为什么要分组: 不同物理量（mm / GeV / degree）量纲不同，混在
        //              一起会导致被高量纲淹没。分组后各自独立评分。
        // ---------------------------------------------------------------
        "groups": [


            // ===========================================================
            //  组 1: 轨道优化（BPM 直接读数，无变换）
            // ===========================================================
            {
                // name   — 组名，仅用于日志输出
                "name": "orbit",
                // weight — 组权重。1.0=标准重要性，0.5=减半
                "weight": 1.0,

                // pvs — 组内目标 PV 列表
                "pvs": [

                    // --- 完整格式（所有字段显式声明） ---
                    {
                        "pv": "LA-BI:SBPM1:POS_X",    # EPICS PV 地址（必填）
                        "target": 0.0,                # 目标值（可选，默认 0.0）
                        "weight": 1.0,                # 组内权重（可选，默认 1.0）
                        "range": [-0.5, 0.5]          # 可接受区间（可选，默认无限制）
                                                      #   读数在 [-0.5, 0.5] 内 → 不惩罚
                                                      #   读数在 [-0.5, 0.5] 外 → 按偏差惩罚
                    },

                    // --- 简化格式（只写 pv，其余字段取默认值） ---
                    // target=0.0, weight=1.0, range=无限制
                    {"pv": "LA-BI:SBPM1:POS_Y", "target": 0.0},
                                                   # 等价于上面的完整格式但省略 range

                    {"pv": "LA-BI:SBPM2:POS_X", "target": 0.0},
                    {"pv": "LA-BI:SBPM2:POS_Y", "target": 0.0}
                ],

                // scoring — 组内评分策略
                //   method: l2 | l1 | max | weighted_sum | custom:<name>
                //   params: 策略专属参数（可选，当前内置策略无额外参数）
                "scoring": {
                    "method": "l2"                 # L2 = 均方根偏差
                                                   # L1 = 绝对偏差（抗离群点）
                                                   # max = 只关心最差的 PV
                                                   # weighted_sum = 直接加权
                }
            },


            // ===========================================================
            //  组 2: 束流能量（带容差区间 — 范围 OK 就不惩罚）
            //  场景: 能量在 2.35~2.45 GeV 之间都是可接受的，不必精确
            // ===========================================================
            {
                "name": "energy",
                "weight": 0.5,                    # 能量组的权重是轨道的一半

                "pvs": [
                    {
                        "pv": "LA-BI:ENERGY:MEAS",
                        "target": 2.4,            # 目标能量值
                        "range": [2.35, 2.45]     # ★ 容差区间: 2.35~2.45 内不惩罚
                                                   #   读数 2.42 → deviation=0（在区间内）
                                                   #   读数 2.50 → deviation=0.05（超出上界）
                                                   #   读数 2.30 → deviation=0.05（超出下界）
                                                   #   不设 range → 总是按 target 偏差惩罚
                    }
                ],
                "scoring": {"method": "l1"}       # L1: 对离群点更鲁棒
            },


            // ===========================================================
            //  组 3: X/Y 方向合并为 RMS 评分
            //  场景: 不关心 X 和 Y 分别多大，只关心总体偏移
            //  使用 transform: "combine" 把一组读数合并成一个值
            // ===========================================================
            {
                "name": "bpm_rms",
                "weight": 0.3,

                "pvs": [
                    {
                        "pv": "LA-BI:SBPM2:POS_X",
                        "target": 0.0,

                        // transform — 数据预处理变换（可选）
                        //   在 caget 读取原始值后、传给 scoring 之前执行
                        //   type:   none | reshape | average | combine | custom:<name>
                        //   params: 变换专属参数
                        "transform": {

                            // combine — 合并多个读数
                            //   本例: SBPM2_X 先读到，SBPM2_Y 后读到，
                            //         combine 把两个值合并算 RMS
                            //   method: "rms"  (默认) — sqrt(mean(values²))
                            //           "max"          — 最大值
                            //           "sum"          — 直接求和
                            "type": "combine",
                            "params": {"method": "rms"}
                        }
                    },

                    // 这个 PV 没有 transform，直接读标量
                    {"pv": "LA-BI:SBPM2:POS_Y", "target": 0.0}
                ],
                "scoring": {"method": "l2"}
            }
        ],


        // ===============================================================
        //  overall_scoring — 多组聚合方式
        //  目前支持 "weighted_sum":
        //    总评分 = sum(group.weight × 组评分 for each group)
        //            ────────────────────────────────────────────
        //                      sum(group.weight for each group)
        //
        //  示例: orbit(w=1.0, s=0.33) + energy(w=0.5, s=2.36) + bpm_rms(w=0.3, s=0.18)
        //        = (1.0×0.33 + 0.5×2.36 + 0.3×0.18) / (1.0 + 0.5 + 0.3)
        //        = (0.33 + 1.18 + 0.054) / 1.8 = 0.869
        // ===============================================================
        "overall_scoring": "weighted_sum"
    },


    // ====================================================================
    //  optimization — 优化器参数
    //  必填: 否（全部有默认值）
    // ====================================================================
    "optimization": {

        // algorithm — 优化算法（Nevergrad 提供 525 种）
        //
        //   推荐:
        //     NGOpt       ← 默认，自动选最佳，不知道选什么就用这个
        //     CMA         ← 鲁棒通用，中等预算 (50-200)
        //     TwoPointsDE ← 差分进化，多局部极值场景
        //     BO          ← 贝叶斯优化，每次评估很贵时 (预算<50)
        //     TBPSA       ← 噪声环境专用
        //     SQP         ← 拟牛顿，已有粗解后局部精调
        //     PSO         ← 粒子群，光滑函数追求速度
        //
        //   决策:
        //     预算<50, 噪声小 → CMA
        //     预算<50, 噪声大 → TBPSA
        //     预算50-200      → NGOpt 或 CMA
        //     极度昂贵(<20)   → BO
        //     局部精调        → SQP
        //
        //   拼写不对时自动退化为 NGOpt
        "algorithm": "NGOpt",

        // budget — 最大迭代次数
        //   实数含义: Nevergrad 内部预算，并非严格的对外循环次数
        //   实际迭代 = budget × 算法内部因子（通常接近 budget）
        "budget": 20,

        // early_stopping — 早停机制
        //   节省时间: 连续 N 轮无显著改进时提前停止
        "early_stopping": {
            "enabled": true,                    # 是否启用早停
            "patience": 5,                      # 连续无改进次数上限
            "min_relative_improvement": 0.005   # 最小相对改进阈值（0.005 = 0.5%）
                                                # 公式: (旧分 − 新分) / 旧分 > 0.005 才算改进
        }
    },


    // ====================================================================
    //  hardware — 硬件控制参数
    //  必填: 否（全部有默认值）
    //
    //  这些参数控制 EPICS PV 的写入验证、等待稳定、重试等硬件保护行为。
    // ====================================================================
    "hardware": {

        // tolerance — 设定值容差
        //   caput 写入后 caget 读回，若 |读回 − 写入| ≤ tolerance 则视为成功
        //   默认 0.0001
        "tolerance": 0.1,                       # 这里设大一点方便测试，生产建议 0.0001

        // max_wait — 等待设备稳定最大秒数
        //   超过此时间未达到 tolerance 则打印警告、视为未稳定
        //   默认 10 秒
        "max_wait": 5,

        // poll_interval — 轮询间隔秒数
        //   等待稳定期间每隔这么多秒读一次
        //   默认 0.2 秒
        "poll_interval": 0.2,

        // min_adjust_interval — 两次调整最小间隔秒数
        //   保护硬件: 两次写入之间至少等这么多秒
        //   默认 6 秒（生产推荐），测试时设 0
        "min_adjust_interval": 0,

        // write_retries — 单次写入失败后的重试次数
        //   默认 3
        "write_retries": 3
    }


    // ====================================================================
    //  附录 A：内置 transform 一览
    // ====================================================================
    //
    //  单个 transform（对象）:
    //    "transform": {"type": "average", "params": {"n": 5}}
    //
    //  transform 链（数组，按顺序执行）:
    //    "transform": [
    //        {"type": "average", "params": {"n": 3}},
    //        {"type": "custom:beam_optimizer", "params": {"shape": [256,256], "order": "F"}}
    //    ]
    //
    // ★★ 重要：average 必须放在链的首位 ★★
    //    average 内部通过 caget_fn 重复读取原始 PV 数据，然后
    //    对原始值逐元素平均。如果放在分析变换之后，输入变成了
    //    分析结果（float），重读时又会读取原始数组，维度不匹配
    //    导致错误。
    //
    //    ✓ 正确: average → reshape → custom:beam_optimizer
    //    ✗ 错误: custom:beam_optimizer → average
    //
    //  reshape:
    //    1D 数组 → ND 数组重组
    //    params: { shape: [dim0, dim1, ...], order: "C" | "F" }
    //    示例: {"type": "reshape", "params": {"shape": [1392, 1040], "order": "F"}}
    //
    //  average:
    //    连续读 N 次原始 PV → 逐元素相加取平均
    //    支持标量（float）和数组（ndarray），均参与逐元素平均
    //    params: { n: 次数 (默认 3), wait: 间隔秒数 (默认 0.5) }
    //    示例: {"type": "average", "params": {"n": 5, "wait": 0.5}}
    //
    //  combine:
    //    合并多个读数
    //    params: { method: "rms" | "max" | "sum" }
    //    示例: {"type": "combine", "params": {"method": "rms"}}
    //
    //  custom:<name>:
    //    用户自定义变换
    //    params: 任意 JSON 对象，传给自定义变换的 __init__
    //    示例: {"type": "custom:beam_size", "params": {"camera_shape": [1392, 1040]}}
    //
    //  自定义变换注册（Python 代码）:
    //    from core.transforms import register_transform, Transform
    //    @register_transform("beam_size")
    //    class BeamSizeTransform(Transform):
    //        def __call__(self, raw_value, *, pv_name="", caget_fn=None):
    //            ...


    // ====================================================================
    //  附录 B：内置 scoring 策略公式一览
    // ====================================================================
    //
    //  l2:           sqrt( Σ(wi × dev_i²) / Σwi )
    //  l1:           Σ(wi × |dev_i|) / Σwi
    //  max:          max(wi × |dev_i|)  for all i
    //  weighted_sum: Σ(wi × dev_i) / Σwi
    //
    //  其中 dev_i = ri − ti（若 PV 有 range 且在该区间内则为 0）

}
