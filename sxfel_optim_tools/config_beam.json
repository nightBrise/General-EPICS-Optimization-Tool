{
  "name": "beam_size",
  "description": "束流尺寸优化 - 最小化束斑尺寸同时优化圆度",
  "objective": {
    "type": "beam_size",
    "read_pvs": ["LA-BI:PRF22:RAW:ArrayData"],
    "params": {
      "camera_shape": [1392, 1040],
      "num_averages": 3,
      "target_diagonal_size_pixels": 0,
      "target_mode": "minimize",
      "target_range": [0, 1000],
      "beam_mode": "balanced",
      "maintain_position": true,
      "fel_mode": "soft",
      "intensity_mode": "max",
      "repetition_rate": 10,
      "min_adjust_interval": 6,
      "poll_interval": 0.2,
      "tolerance": 0.0001,
      "max_wait": 10
    }
  },
  "camera": {
    "pv": "LA-BI:PRF22:RAW:ArrayData",
    "camera_shape": [1392, 1040],
    "gain_pv": "LA-BI:PRF22:CAM:GainRaw",
    "gain_range": [0, 500]
  },
  "image_processing": {
    "num_averages": 3
  },
  "optimization": {
    "algorithm": "Compass",
    "budget": 50,
    "early_stopping": {
      "enabled": true,
      "patience": 10,
      "min_relative_improvement": 0.005
    },
    "params": {
      "// 算法特有参数（可选）": "",
      "// population_size: 30,    // CMA, DE 等遗传算法": "",
